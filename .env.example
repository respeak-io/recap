# Supabase Cloud credentials (from https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (video processing, translation, docs search answers)
GEMINI_API_KEY=

# Hard daily cap in USD for AI answers in the public docs search (UTC day).
# When reached, search keeps working and only the AI answer is skipped. Default: 5
AI_DAILY_BUDGET_USD=5

# Public origin of the docs site, used for canonical / hreflang / sitemap URLs.
# Defaults to https://docs.respeak.io when unset.
NEXT_PUBLIC_DOCS_URL=https://docs.respeak.io
