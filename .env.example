# Supabase Cloud credentials (from https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key (for video processing)
GEMINI_API_KEY=

# Public origin of the docs site, used for canonical / hreflang / sitemap URLs.
# Defaults to https://docs.respeak.io when unset.
NEXT_PUBLIC_DOCS_URL=https://docs.respeak.io
